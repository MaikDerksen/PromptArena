rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // WARNING: These rules are temporarily insecure for debugging the connection issue.
    // They allow anyone to read and write to the game state.
    // We must secure these rules again after confirming the fix.
    match /games/{gameId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Allow the Firebase Stripe Extension to create checkout sessions
      match /checkout_sessions/{sessionId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    match /generated_images/{imageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
