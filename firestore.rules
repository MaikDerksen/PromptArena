rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Game data: Allow read for anyone, write only for authenticated users (admin controls)
    match /games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null; // Simplistic: any logged-in user can write.
                                          // For production, you'd restrict this to admins.
    }

    // User profiles and Stripe extension data:
    match /users/{userId} {
      // Existing user profile permissions
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null; // Allows user to create their own doc on signup

      // Stripe extension subcollections for the user
      // Users can read/write their own checkout_sessions
      match /checkout_sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Users can read their own subscriptions
      match /subscriptions/{subscriptionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
      // Users can read their own payments
      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Stripe extension products data (publicly readable as per extension example)
    // Products and their prices are typically publicly readable
    match /products/{productId} {
      allow read: if true;

      match /prices/{priceId} {
        allow read: if true;
      }

      match /tax_rates/{taxRateId} {
        allow read: if true; // Or restrict if needed, but often public
      }
    }
  }
}
