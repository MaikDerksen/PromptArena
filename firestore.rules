rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the update is only for player connection status
    function isPlayerConnectionUpdate() {
      // Check for playerOneConnected or playerTwoConnected fields, ensure no other fields are changed besides updatedAt and a lastSeen field
      let allowedKeys = ['updatedAt', 'playerOneConnected', 'playerOneLastSeen', 'playerTwoConnected', 'playerTwoLastSeen'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // Helper function to check if the update is only for player typing/submission data
    function isPlayerActionUpdate() {
      // Unauthenticated users can update their own prompt, typing prompt, and last seen timestamp.
      let playerOneKeys = ['updatedAt', 'playerOneLastSeen', 'playerOneTypingPrompt', 'playerOnePrompt', 'playerOneImage'];
      let playerTwoKeys = ['updatedAt', 'playerTwoLastSeen', 'playerTwoTypingPrompt', 'playerTwoPrompt', 'playerTwoImage'];
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      
      // Ensure the update only contains keys from one of the player lists
      return (keys.hasAll(playerOneKeys) == false && keys.hasOnly(playerTwoKeys)) || 
             (keys.hasAll(playerTwoKeys) == false && keys.hasOnly(playerOneKeys));
    }

    // Game data can be read by anyone.
    // Writes are more specific:
    // - Authenticated users (admins) can write anything.
    // - Unauthenticated users (session players) can only update specific fields related to gameplay.
    match /games/{gameId} {
      allow read;
      allow write: if request.auth != null || isPlayerConnectionUpdate() || isPlayerActionUpdate();
    }

    // User profiles are private.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Generated images can be read by anyone, but only created by authenticated users.
    match /generated_images/{imageId} {
      allow read;
      allow create: if request.auth != null;
    }

    // Stripe checkout sessions
    match /users/{userId}/checkout_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
