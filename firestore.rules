rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Game document: Allow anyone to read, but restrict writes.
    match /games/{gameId} {
      allow read: if true;
      
      // Allow writes only if a user is authenticated (is an admin/player)
      // OR if the write is only to update connection status or last seen,
      // which is what our session-based QR code users need to do.
      allow write: if request.auth != null || 
                      (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['playerOneConnected', 'playerTwoConnected', 'playerOneLastSeen', 'playerTwoLastSeen', 'playerOneTypingPrompt', 'playerTwoTypingPrompt', 'updatedAt']));
    }

    // User profiles: Only the authenticated user can read/write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Checkout sessions: Only the authenticated user can create checkout sessions for themselves.
    match /users/{userId}/checkout_sessions/{sessionId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      // Stripe extension needs to update this document
      allow read, write: if request.auth != null && request.auth.uid == userId; 
    }
    
    // Generated Images: Any authenticated user can create an image record.
    // Only the user who created it can read it.
    match /generated_images/{imageId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // No updates or deletes from the client side.
      allow update, delete: if false;
    }
  }
}
