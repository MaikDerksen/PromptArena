
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Game document: /games/default-game
    match /games/{gameId} {
      // Allow read access for everyone (players, viewers, admin)
      allow read: if true;

      // Allow creation of the game document if it doesn't exist
      // This is typically handled by the application on first load if the game doesn't exist.
      allow create: if request.resource.data.id == 'default-game';

      // Allow updates to the game document
      // This covers admin setting prompts/status, and players submitting their prompts/images.
      // For production, this should be more granular (e.g., only admin can update `prompt` and `status`,
      // players can only update their respective fields if authenticated and game is 'active').
      allow update: if resource.data.id == 'default-game';

      // Disallow deletion of the game document
      allow delete: if false;
    }

    // Deny all other writes/reads by default if not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
