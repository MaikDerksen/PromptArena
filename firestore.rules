
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // A user can read and update their own profile.
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // A user can create their own profile document during signup.
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    match /games/{gameId} {
      // Anyone can view the game state for the spectator page.
      allow read: if true;
      // Only authenticated users can update the game state.
      // This covers players submitting prompts and admins managing the game.
      allow write: if request.auth != null;
    }

    match /generated_images/{imageId} {
      // A user can read an image document if they are the one who created it.
      // This rule secures the collection so only the owner can query for their own images.
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // A user can create an image document if they are logged in and the document's userId matches their own.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // No one can update or delete from the client. This protects the data integrity.
      // Deletion is handled via a trusted server-side process (the account deletion function).
      allow update, delete: if false;
    }
  }
}
