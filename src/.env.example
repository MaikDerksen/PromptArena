# Firebase Configuration - Get these from your Firebase project settings
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"

# Google AI (Gemini) API Key - Get this from Google AI Studio
GOOGLE_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Stripe API Keys
# Get your Publishable key from the Stripe Dashboard (Developers > API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"
# Get your Secret key from the Stripe Dashboard (Developers > API keys)
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"
# Get your Webhook Signing Secret from the Stripe Dashboard after creating a webhook endpoint (Developers > Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# Application URL (Base URL for redirects, e.g., http://localhost:9002 or your public dev/prod URL)
# If using a public dev URL like Cloud Workstations, use that here.
# Example for Cloud Workstations: https://your-port-your-instance.cluster.cloudworkstations.dev
NEXT_PUBLIC_APP_URL=https://6000-firebase-studio-1750143203602.cluster-c23mj7ubf5fxwq6nrbev4ugaxa.cloudworkstations.dev
