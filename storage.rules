
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any files in the user-images directory
    match /user-images/{userId}/{gameId}/{allPaths=**} {
      // Allow read access to anyone (e.g., for viewer page)
      // For stricter privacy, change to: allow read: if request.auth != null && request.auth.uid == userId;
      // or implement signed URLs if images need to be public but temporary.
      allow read: if true; 
      
      // Allow write access only to the authenticated user who owns this path
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Optional: If you have general game images not tied to users
    // match /game-images/{gameId}/{allPaths=**} {
    //   allow read: if true;
    //   allow write: if request.auth != null; // Or more specific admin rules
    // }
  }
}
