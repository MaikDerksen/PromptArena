rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files in the 'game-images' folder
    // This is needed so that the <Image> component can display them via URL
    match /game-images/{allPaths=**} {
      allow read;
    }

    // Allow writes to the 'game-images/{gameId}/{fileName}' path
    // For now, this is quite open. In a production app, you'd add authentication
    // checks, e.g., only authenticated users can write, or specific users/roles.
    // We also check for image type and a reasonable size.
    match /game-images/{gameId}/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && request.resource.contentType.matches('image/.*');
      // Example for authenticated users (if you implement player auth):
      // allow write: if request.auth != null
      //              && request.resource.size < 5 * 1024 * 1024
      //              && request.resource.contentType.matches('image/.*');
    }
  }
}
