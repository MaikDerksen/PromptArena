
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files in the game-images directory.
    // This allows images to be displayed in the client application.
    match /game-images/{gameId}/{allPaths=**} {
      allow read: if true;
    }

    // Allow writes (uploads) to the game-images directory.
    // In a production app, you would restrict this further, e.g., only authenticated users,
    // specific file types, size limits, or only if a corresponding Firestore document exists.
    // For this project, we're keeping it simple for the image generation flow.
    match /game-images/{gameId}/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024 // Max 5MB per image
                     && request.resource.contentType.matches('image/png'); // Only PNG images
    }

    // Deny all other reads/writes by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
